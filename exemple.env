# Copiez ce fichier en .env et adaptez les valeurs.

# Clé API Prowlarr (Settings > General > Security dans l'UI Prowlarr).
PROWLARR_API_KEY=changeme

# URL de base de Prowlarr (sans slash final).
# En Docker Compose, le nom du service est résolvable : http://prowlarr:9696
PROWLARR_BASE_URL=http://prowlarr:9696

# Secret applicatif utilisé pour signer les liens de téléchargement (HMAC).
# Générez-en un : openssl rand -hex 32
APP_SECRET=changeme-generate-a-random-secret

# Optionnel (valeurs par défaut indiquées).
PROWLARR_TIMEOUT=15
CACHE_TTL=120
CACHE_DIR=/tmp/indexof_cache
