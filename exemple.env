# Copiez ce fichier en .env et adaptez les valeurs.

# --- Prowlarr (obligatoire) ---
# Clé API Prowlarr (Settings > General > Security dans l'UI Prowlarr).
PROWLARR_API_KEY=changeme
# URL de base de Prowlarr (sans slash final).
# En Docker Compose, le nom du service est résolvable : http://prowlarr:9696
PROWLARR_BASE_URL=http://prowlarr:9696

# --- Application ---
# OBLIGATOIRE. Clé de chiffrement des liens de téléchargement. L'app REFUSE de
# démarrer sans (ni avec une valeur 'changeme...' ou < 16 caractères).
#   openssl rand -hex 32
APP_SECRET=changeme-generate-a-random-secret
# OBLIGATOIRE. Mot de passe d'accès (choisir une passphrase longue). Pour démarrer
# volontairement SANS authentification, il faut explicitement AUTH_DISABLED=1.
APP_PASSWORD=
# Mettre à 1 pour désactiver sciemment l'auth (déconseillé, surtout en multi-user).
AUTH_DISABLED=0
# Mettre à 1 uniquement derrière un reverse-proxy de confiance qui pose
# X-Forwarded-For (rate-limit login sur l'IP réelle du client).
TRUST_PROXY=0
# Nombre maximum de résultats renvoyés par recherche.
RESULT_LIMIT=200

# --- qBittorrent (optionnel) ---
# URL de la Web UI qBittorrent. Vide = bouton "envoyer" masqué.
# En Docker Compose : http://qbittorrent:8081
QBITTORRENT_URL=
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# --- Applications *arr (optionnel) ---
# Renseignez URL + clé API pour faire apparaître le bouton d'envoi sur chaque
# résultat. La release est poussée à l'application, qui la rapproche de ce
# qu'elle suit, applique ses profils de qualité et lance le téléchargement.
# Clé API : Settings > General dans chaque application.
# En Docker Compose (profil « arr ») : http://sonarr:8989, http://radarr:7878
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
READARR_URL=
READARR_API_KEY=

# --- Notifications Discord (optionnel) ---
# URL de webhook d'un salon Discord. Activez ensuite la cloche sur les
# recherches enregistrées à surveiller, et lancez le service :
#   docker compose --profile notify up -d
DISCORD_WEBHOOK=
# Intervalle entre deux vérifications, en secondes.
NOTIFY_INTERVAL=900

# --- Avancé (valeurs par défaut indiquées) ---
# Délai d'une recherche Prowlarr. Elle interroge les trackers en direct : 1 à 5 s
# en temps normal, bien plus si un indexeur est en erreur. Trop bas = échec alors
# que la recherche aurait abouti.
PROWLARR_TIMEOUT=45
# qBittorrent est local, il n'a pas besoin d'autant.
QBITTORRENT_TIMEOUT=15
CACHE_TTL=120
CACHE_DIR=/tmp/indexof_cache

# --- Bibliothèque et lecture ---------------------------------------------
# Dossier des téléchargements, monté en lecture seule par docker-compose.
# Absent ou vide : la vue Bibliothèque disparaît, le reste fonctionne.
MEDIA_DIR=/media
# Validité d'un lien de lecture (secondes). Il vaut autorisation à lui seul —
# VLC sur une télévision n'a pas le cookie du navigateur. 12 h par défaut.
STREAM_TTL=43200

# --- Envoi vers un téléviseur (Cast) --------------------------------------
# Adresse de l'application VUE DEPUIS LE RÉSEAU LOCAL : c'est elle qu'on donne
# au téléviseur, qui ira chercher la vidéo lui-même. Vide = déduite de la
# requête, ce qui suffit dès qu'on consulte l'app depuis un autre appareil.
# Un « localhost » ici et le téléviseur cherchera chez lui : l'envoi est refusé
# avec le motif plutôt que de laisser un écran noir.
#PUBLIC_BASE_URL=http://192.168.1.50:8080
# Le service de découverte n'est pas lancé par défaut :
#   docker compose --profile cast up -d
CAST_SCAN_INTERVAL=60

# --- Conversion a la volee -------------------------------------------------
# « Si l'appareil sait lire, il lit ; sinon on convertit. » La decision se prend
# sur les codecs reels : un MKV en H.264/AAC est simplement recopie dans du MP4
# (quasiment gratuit), seul ce qui doit l'etre est reellement reencode.
# 0 = lecture directe uniquement (aucun processeur mobilise).
TRANSCODE=1
# Conversions simultanees. Chacune occupe un worker php-fpm et un coeur :
# sans plafond, trois lectures suffisent a figer une machine modeste.
TRANSCODE_MAX=2

# --- Emplacement des telechargements ---------------------------------------
# Dossier de l'HOTE ou qBittorrent depose les fichiers. Par defaut
# ./data/downloads, dans le projet -- souvent sur une petite partition.
# Pointez-le vers un disque avec de l'espace ; le chemin dans les conteneurs
# reste /downloads, donc rien d'autre ne change.
# Le dossier doit appartenir a PUID:PGID (1000:1000) et etre lisible par tous
# (chmod 755) : l'application le lit en tant que www-data pour la bibliotheque.
#DOWNLOADS_DIR=/mnt/disque/indexof-downloads
# Dossier des segments HLS (envoi vers un televiseur). Comptez la taille du film
# par lecture en cours ; le menage se fait au bout de six heures. A placer sur un
# disque avec de l'espace, et a donner a l'utilisateur du conteneur PHP :
#   docker run --rm -v /chemin:/t alpine chown 82:82 /t
#TRANSCODE_DIR=/mnt/disque/indexof-transcode
# Adresse d'ecoute de l'application. 127.0.0.1 par defaut : exposez via un
# reverse-proxy TLS. Le Cast fait exception -- le televiseur vient chercher la
# video lui-meme et ne sait pas quoi faire d'un « localhost ». Dans ce cas
# seulement, mettez l'adresse de la machine sur le reseau local (jamais 0.0.0.0).
#BIND_ADDR=192.168.1.50
